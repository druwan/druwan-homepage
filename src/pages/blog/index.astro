---
import Base from '../../layouts/Base.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import { getLiveCollection } from 'astro:content'

const { entries: posts, error } = await getLiveCollection('blog')
---

<Base title="Blog — Christopher Vestman">
  <Nav slot="nav" />
  <section class="w-full flex flex-col flex-1 pb-8">
    <p class="mb-4 font-medium tracking-tight">
      Some notes from my life, mainly writing for tracking my progress of
      learning <span class="text-burgundy dark:text-ochre">Sinhala</span> and Kubernetes.
    </p>
    <hr class="w-full mb-4 h-px border-0 bg-burgundy/30 dark:bg-ochre/40" />
    {
      error && (
        <p class="text-sm text-burgundy dark:text-ochre">
          Could not load posts.
        </p>
      )
    }
    <div>
      {
        (posts ?? []).map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="flex justify-between items-baseline mb-2 gap-4 transition-opacity duration-200 hover:opacity-80"
          >
            <p class="text-base sm:text-lg text-burgundy dark:text-ochre truncate">
              {post.data.title}
            </p>
            <p class="text-night/60 dark:text-anti-flash-white/60 tabular-nums text-sm shrink-0">
              {new Date(Number(post.data.date)).toISOString().split('T')[0]}
            </p>
          </a>
        ))
      }
    </div>
  </section>
  <Footer slot="footer" />
</Base>
