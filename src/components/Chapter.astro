---
interface Props {
  id: string
  numeral: string
  title: string
}
const { id, numeral, title } = Astro.props
---

<section
  id={id}
  class="mt-10 pt-6 border-t border-night/10 dark:border-anti-flash-white/10 scroll-mt-20"
>
  <div class="flex items-baseline gap-3 mb-4">
    <span class="font-heading text-base text-burgundy dark:text-ochre"
      >{numeral}</span
    >
    <h2
      class="font-heading text-xl text-night dark:text-anti-flash-white tracking-tight"
    >
      {title}
    </h2>
  </div>
  <slot />
</section>
