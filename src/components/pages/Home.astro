---
import Base from '../../layouts/Base.astro'
import Nav from '../Nav.astro'
import Footer from '../Footer.astro'
import ProjectsPanel from '../ProjectsPanel.astro'
import ExploreTabs from '../ExploreTabs'
import { getDictionary } from '../../i18n'
import { getRelativeLocaleUrl } from 'astro:i18n'
import { listPosts } from '../../lib/blog'

interface Props {
  locale: string
}
const { locale } = Astro.props
const t = getDictionary(locale)

let recentPosts: Awaited<ReturnType<typeof listPosts>> = []
try {
  recentPosts = (await listPosts()).slice(0, 2)
} catch {
  recentPosts = []
}

const tabItems = [
  {
    id: 'exploring',
    icon: 'rocket' as const,
    title: t.exploring.title,
    body: t.exploring.body,
    href: 'https://github.com/druwan/homelab',
    linkLabel: t.exploring.link,
    external: true,
  },
  {
    id: 'sriLanka',
    icon: 'globe' as const,
    title: t.sriLanka.title,
    body: t.sriLanka.body,
  },
  {
    id: 'about',
    icon: 'user' as const,
    title: t.about.title,
    body: t.about.teaser,
    href: getRelativeLocaleUrl(locale, 'about'),
    linkLabel: t.about.readMore,
  },
  {
    id: 'blog',
    icon: 'book' as const,
    title: t.blog.title,
    body: t.blog.teaser,
    href: getRelativeLocaleUrl(locale, 'blog'),
    linkLabel: t.blog.allPosts,
    extra: recentPosts.map((post) => ({
      label: post.title,
      href: getRelativeLocaleUrl(locale, `blog/${post.slug}`),
    })),
  },
]
---

<Base>
  <Nav slot="nav" locale={locale} />
  <section class="w-full flex flex-col flex-1 py-8">
    <div class="w-full">
      <p
        class="text-xs uppercase tracking-widest text-burgundy/70 dark:text-ochre/70 mb-2"
      >
        {t.hero.eyebrow}
      </p>
      <h1
        class="text-2xl sm:text-3xl font-medium tracking-tight text-night dark:text-anti-flash-white leading-snug max-w-2xl"
      >
        {t.hero.tagline}
      </h1>
    </div>

    <div
      class="w-full grid grid-cols-1 sm:grid-cols-3 gap-x-8 gap-y-6 py-6 border-t border-b border-night/10 dark:border-anti-flash-white/10"
    >
      <div>
        <h3
          class="text-lg font-medium tracking-tight text-night dark:text-anti-flash-white mb-2"
        >
          {t.dimensions.engineer.title}
        </h3>
        <p
          class="text-sm text-night/60 dark:text-anti-flash-white/60 leading-relaxed"
        >
          {t.dimensions.engineer.body}
        </p>
      </div>
      <div
        class="sm:border-l sm:border-night/10 sm:dark:border-anti-flash-white/10 sm:pl-8"
      >
        <h3
          class="text-lg font-medium tracking-tight text-night dark:text-anti-flash-white mb-2"
        >
          {t.dimensions.developer.title}
        </h3>
        <p
          class="text-sm text-night/60 dark:text-anti-flash-white/60 leading-relaxed"
        >
          {t.dimensions.developer.body}
        </p>
      </div>
      <div
        class="sm:border-l sm:border-night/10 sm:dark:border-anti-flash-white/10 sm:pl-8"
      >
        <h3
          class="text-lg font-medium tracking-tight text-night dark:text-anti-flash-white mb-2"
        >
          {t.dimensions.builder.title}
        </h3>
        <p
          class="text-sm text-night/60 dark:text-anti-flash-white/60 leading-relaxed"
        >
          {t.dimensions.builder.body}
        </p>
      </div>
    </div>

    <div
      class="w-full py-6 border-t border-night/10 dark:border-anti-flash-white/10"
    >
      <ProjectsPanel locale={locale} />
    </div>

    <div
      class="w-full py-6 border-t border-night/10 dark:border-anti-flash-white/10"
    >
      <ExploreTabs client:only="preact" items={tabItems} />
    </div>
  </section>
  <Footer slot="footer" />
</Base>
