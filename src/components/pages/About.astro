---
import Base from '../../layouts/Base.astro'
import Nav from '../Nav.astro'
import Footer from '../Footer.astro'
import { getDictionary } from '../../i18n'

interface Props {
  locale: string
}
const { locale } = Astro.props
const t = getDictionary(locale)
---

<Base locale={locale} title={`${t.about.title} — Christopher Vestman`}>
  <Nav slot="nav" locale={locale} />
  <section class="w-full flex flex-col flex-1 py-8 gap-6">
    <h1
      class="font-serif text-3xl sm:text-4xl text-night dark:text-anti-flash-white leading-tight ..."
    >
      {t.about.title}
    </h1>
    <hr class="w-full h-px border-0 bg-burgundy/30 dark:bg-ochre/40" />
    <p class="text-night dark:text-anti-flash-white leading-relaxed">
      {t.about.teaser}
    </p>
    <p class="text-night dark:text-anti-flash-white leading-relaxed">
      {t.about.paragraph2}
    </p>
  </section>
  <Footer slot="footer" />
</Base>
