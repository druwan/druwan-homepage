---
import Base from '../../layouts/Base.astro'
import Nav from '../Nav.astro'
import Footer from '../Footer.astro'
import { getDictionary } from '../../i18n'
import { listPosts } from '../../lib/blog'
import { getRelativeLocaleUrl } from 'astro:i18n'

interface Props {
  locale: string
}
const { locale } = Astro.props
const t = getDictionary(locale)
const posts = await listPosts()
---

<Base title={`${t.blog.title} — Christopher Vestman`} locale={locale}>
  <Nav slot="nav" locale={locale} />
  <article class="w-full flex-1 py-8">
    <h1
      class="font-heading text-3xl sm:text-4xl text-night dark:text-anti-flash-white leading-tight ..."
    >
      {t.blog.title}
    </h1>
    <p
      class="text-base text-night/70 dark:text-anti-flash-white/70 leading-relaxed mb-8"
    >
      {t.blog.teaser}
    </p>

    <div>
      {
        posts.length === 0 && (
          <p class="text-sm text-night/60 dark:text-anti-flash-white/60 py-6">
            —
          </p>
        )
      }
      {
        posts.map((post) => (
          <a
            href={getRelativeLocaleUrl(locale, `blog/${post.slug}`)}
            class="flex justify-between items-baseline gap-4 py-3 group"
          >
            <h2 class="font-sans text-base text-burgundy dark:text-ochre group-hover:opacity-70 transition-opacity truncate">
              {post.title}
            </h2>
            <p class="text-sm text-night/50 dark:text-anti-flash-white/50 tabular-nums shrink-0">
              {new Date(Number(post.date)).toISOString().split('T')[0]}
            </p>
          </a>
        ))
      }
    </div>
  </article>
  <Footer slot="footer" />
</Base>
