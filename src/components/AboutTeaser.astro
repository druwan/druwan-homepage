---
import { getDictionary } from '../i18n'
import { getRelativeLocaleUrl } from 'astro:i18n'

interface Props {
  locale: string
}
const { locale } = Astro.props
const t = getDictionary(locale)
const aboutUrl = getRelativeLocaleUrl(locale, 'about')
---

<div class="w-full flex flex-col sm:flex-row gap-3 sm:gap-6">
  <div class="flex items-center gap-4 sm:contents">
    <div class="w-0.5 h-8 sm:h-11 bg-burgundy dark:bg-ochre shrink-0 sm:mt-0.5">
    </div>
    <h3
      class="text-lg sm:text-xl font-medium tracking-tight text-night dark:text-anti-flash-white sm:min-w-[130px] sm:shrink-0"
    >
      {t.about.title}
    </h3>
  </div>
  <div class="sm:pt-0.5">
    <p
      class="text-sm text-night/60 dark:text-anti-flash-white/50 leading-relaxed"
    >
      {t.about.teaser}
    </p>
    <a
      href={aboutUrl}
      class="inline-flex items-center gap-1 text-sm text-burgundy dark:text-ochre mt-2"
    >
      {t.about.readMore} →
    </a>
  </div>
</div>
