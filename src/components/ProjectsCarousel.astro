---
import { supabase } from '../lib/supabaseClient'
import { Image } from 'astro:assets'

const { data: projects, error } = await supabase
  .from('projects')
  .select('*')
  .eq('publish', true)
  .order('id')

const items = projects ?? []
---

{error && <p class="text-sm text-burgundy dark:text-ochre">Could not load projects.</p>}

{items.length > 0 && (
<div id="carousel" class="relative w-full overflow-hidden rounded-xl" style="aspect-ratio: 16/9; isolation: isolate;">

    {items.map((project, i) => (
      <a
        href={project.repo_url}
        class="carousel-slide absolute inset-0 transition-opacity duration-700 overflow-hidden outline-none"
        style={`opacity: ${i === 0 ? '1' : '0'}; z-index: ${i === 0 ? '1' : '0'};`}
        tabindex={i === 0 ? '0' : '-1'}
        data-index={i}
      >
        <img
          src={project.image_url}
          alt={`Preview of ${project.title}`}
          class="w-full h-full object-cover"
          loading={i === 0 ? 'eager' : 'lazy'}
          decoding="async"
          fetchPriority={i === 0 ? 'high' : 'auto'}
          />
        <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(13,13,13,0.95) 0%, rgba(13,13,13,0.3) 55%, transparent 100%);"></div>
        <div class="absolute bottom-0 left-0 right-0 p-5">
          <p class="text-xs uppercase tracking-widest text-ochre mb-1" style="text-shadow: 0 1px 3px rgba(0,0,0,0.9);">Project</p>
          <h3 class="text-xl font-medium text-anti-flash-white mb-1" style="text-shadow: 0 1px 4px rgba(0,0,0,0.9);">{project.title}</h3>
          <p class="text-sm text-anti-flash-white/60 line-clamp-2" style="text-shadow: 0 1px 3px rgba(0,0,0,0.8);">{project.description}</p>
        </div>
      </a>
    ))}

  </div>
  <!-- Dot indicators -->
  <div class="flex gap-2 justify-center mt-3">
    {items.map((_, i) => (
      <button
        class={`carousel-dot transition-all duration-300 ${i === 0 ? 'dot-active' : 'dot-inactive'}`}
        style={`width: ${i === 0 ? '18px' : '6px'}; height: 6px; border-radius: ${i === 0 ? '3px' : '50%'}; padding: 0; cursor: pointer;`}
        data-index={i}
        aria-label={`Go to project ${i + 1}`}
      />
    ))}
  </div>
)}

<script>
  const slides = document.querySelectorAll<HTMLElement>('.carousel-slide')
  const dots = document.querySelectorAll<HTMLElement>('.carousel-dot')
  let current = 0
  let timer: ReturnType<typeof setInterval>

  function goTo(index: number) {
    slides[current].style.opacity = '0'
    slides[current].style.zIndex = '0'
    slides[current].setAttribute('tabindex', '-1')

    dots[current].style.width = '6px'
    dots[current].style.borderRadius = '50%'
    dots[current].classList.remove('dot-active')
    dots[current].classList.add('dot-inactive')

    current = index
    slides[current].style.opacity = '1'
    slides[current].style.zIndex = '1'
    slides[current].setAttribute('tabindex', '0')

    dots[current].style.width = '18px'
    dots[current].style.borderRadius = '3px'
    dots[current].classList.remove('dot-inactive')
    dots[current].classList.add('dot-active')
  }

  function next() {
    goTo((current + 1) % slides.length)
  }

  function startTimer() {
    timer = setInterval(next, 3000)
  }

  function stopTimer() {
    clearInterval(timer)
  }

  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      stopTimer()
      goTo(Number(dot.dataset.index))
      startTimer()
    })
  })

  const carousel = document.getElementById('carousel')
  carousel?.addEventListener('mouseenter', stopTimer)
  carousel?.addEventListener('mouseleave', startTimer)

  startTimer()
</script>
