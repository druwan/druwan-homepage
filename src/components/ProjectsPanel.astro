---
import { getDictionary } from '../i18n'
import { getProjects } from '../lib/projects'
import Tabs from './Tabs'

interface Props {
  locale: string
}
const { locale } = Astro.props
const t = getDictionary(locale)

const items = await getProjects()

const tabItems = items.map((p) => ({
  id: p.repo_url,
  label: p.title,
  title: p.title,
  body: p.description,
  media: { image: p.image_url, href: p.repo_url },
  meta: p.stack.map((s) => s.name).join(' · '),
  links: [
    { label: t.projects.code, href: p.repo_url, icon: 'code' as const },
    ...(p.live_url
      ? [
          {
            label: t.projects.live,
            href: p.live_url,
            icon: 'external' as const,
            external: true,
          },
        ]
      : []),
  ],
}))
---

<div class="w-full">
  <h3
    class="text-lg sm:text-xl font-medium tracking-tight text-night dark:text-anti-flash-white mb-6"
  >
    {t.projects.title}
  </h3>

  {
    items.length === 0 && (
      <p class="text-sm text-night/65 dark:text-anti-flash-white/65">—</p>
    )
  }

  {items.length > 0 && <Tabs client:only="preact" items={tabItems} />}
</div>
