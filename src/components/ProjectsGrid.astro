---
import { getDictionary } from '../i18n'
import { getProjects } from '../lib/projects'
import { ExternalLink, Code2 } from 'lucide-preact'

interface Props {
  locale: string
}
const { locale } = Astro.props
const t = getDictionary(locale)

const items = await getProjects()
---

<div class="w-full">
  <div class="flex items-center gap-4 mb-6">
    <div class="w-0.5 h-8 bg-burgundy dark:bg-ochre shrink-0"></div>
    <h3
      class="text-lg sm:text-xl font-medium tracking-tight text-night dark:text-anti-flash-white"
    >
      {t.projects.title}
    </h3>
  </div>

  {
    items.length === 0 && (
      <p class="text-sm text-night/50 dark:text-anti-flash-white/50">—</p>
    )
  }

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-8">
    {
      items.map((project) => (
        <div class="flex flex-col gap-3">
          <div
            class="w-full overflow-hidden rounded-lg border border-night/10 dark:border-anti-flash-white/10"
            style="aspect-ratio: 16/9;"
          >
            <img
              src={project.image_url}
              alt={`Preview of ${project.title}`}
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="flex flex-col gap-1">
            <h4 class="text-base font-medium text-night dark:text-anti-flash-white">
              {project.title}
            </h4>
            <p class="text-sm text-night/60 dark:text-anti-flash-white/50 leading-relaxed line-clamp-2">
              {project.description}
            </p>
          </div>

          {project.stack.length > 0 && (
            <p class="text-xs text-night/40 dark:text-anti-flash-white/35 tracking-wide">
              {project.stack.map((s) => s.name).join(' · ')}
            </p>
          )}

          <div class="flex items-center gap-4 mt-1">
            <a
              href={project.repo_url}
              class="inline-flex items-center gap-1.5 text-sm text-burgundy dark:text-ochre"
            >
              <Code2 size={14} /> {t.projects.code}
            </a>
            {project.live_url && (
              <a
                href={project.live_url}
                class="inline-flex items-center gap-1.5 text-sm text-burgundy dark:text-ochre"
              >
                <ExternalLink size={14} /> {t.projects.live}
              </a>
            )}
          </div>
        </div>
      ))
    }
  </div>
</div>
