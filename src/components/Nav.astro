---
import MobileNav from './MobileNav'
import ThemeToggle from './ThemeToggle'
import LanguageSwitcher from './LanguageSwitcher.astro'
import { getRelativeLocaleUrl } from 'astro:i18n'
import { getDictionary } from '../i18n'

interface Props {
  locale: string
}
const { locale } = Astro.props
const t = getDictionary(locale)
const homeUrl = getRelativeLocaleUrl(locale, '')
const blogUrl = getRelativeLocaleUrl(locale, 'blog')

const chapters = [
  { id: 'about', label: t.about.title, href: `${homeUrl}#about` },
  { id: 'work', label: t.chapters.work, href: `${homeUrl}#work` },
  { id: 'now', label: t.chapters.now, href: `${homeUrl}#now` },
  {
    id: 'selected-work',
    label: t.chapters.selectedWork,
    href: `${homeUrl}#selected-work`,
  },
  { id: 'blog', label: t.blog.title, href: blogUrl },
]
---

<nav class="w-full flex items-center justify-between gap-3">
  <a
    href={homeUrl}
    class="text-xl sm:text-2xl md:text-3xl font-medium tracking-tight text-burgundy dark:text-ochre truncate"
  >
    Christopher Vestman
  </a>

  <div class="flex items-center gap-1 shrink-0">
    <div
      class="hidden md:flex items-center gap-4 text-sm tracking-widest text-night/60 dark:text-anti-flash-white/60 mr-2"
    >
      {
        chapters.map((c) => (
          <a
            href={c.href}
            class="hover:text-burgundy dark:hover:text-ochre transition-colors"
          >
            {c.label}
          </a>
        ))
      }
    </div>

    <LanguageSwitcher />
    <ThemeToggle client:only="preact" />

    <div class="md:hidden">
      <MobileNav client:only="preact" locale={locale} chapters={chapters} />
    </div>
  </div>
</nav>
