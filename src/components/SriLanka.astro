---
import { getDictionary } from '../i18n'

interface Props {
  locale: string
}
const { locale } = Astro.props
const t = getDictionary(locale)
---

<div class="w-full flex flex-col sm:flex-row gap-3 sm:gap-6">
  <div class="flex items-center gap-4 sm:contents">
    <div class="w-0.5 h-8 sm:h-11 bg-ochre shrink-0 sm:mt-0.5"></div>
    <h3
      class="text-lg sm:text-xl font-medium tracking-tight text-night dark:text-anti-flash-white sm:min-w-[130px] sm:shrink-0"
    >
      {t.sriLanka.title}
    </h3>
  </div>
  <p
    class="text-sm text-night/60 dark:text-anti-flash-white/50 leading-relaxed sm:pt-0.5"
  >
    {t.sriLanka.body}
  </p>
</div>
