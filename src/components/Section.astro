---
interface Props {
  title: string
  body: string
  href?: string
  linkLabel?: string
  external?: boolean
}
const { title, body, href, linkLabel, external = false } = Astro.props
---

<div
  class="w-full py-6 border-t border-night/10 dark:border-anti-flash-white/10 first:border-t-0 first:pt-0"
>
  <h3
    class="text-lg sm:text-xl font-medium tracking-tight text-night dark:text-anti-flash-white mb-2"
  >
    {title}
  </h3>
  <p
    class="text-sm text-night/60 dark:text-anti-flash-white/60 leading-relaxed max-w-2xl"
  >
    {body}
  </p>
  <slot />
  {
    href && (
      <a
        href={href}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener noreferrer' : undefined}
        class="inline-flex items-center gap-1 text-sm text-burgundy dark:text-ochre mt-3"
      >
        {linkLabel} {external ? '↗' : '→'}
      </a>
    )
  }
</div>
