    "@tailwindcss/vite": "^4.1.8",
    "astro": "^7.2.1",
    "aws4fetch": "^1.0.20",
    "dotenv": "^17.2.4",
    "highlight.js": "^11.11.1",
    "lucide-preact": "^1.39.0",
    "marked": "^18.0.4",
    "preact": "^10.0.0",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.0.0",
